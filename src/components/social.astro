---
interface Props {
  platform: string
  username: string
}

const { platform, username } = Astro.props
const href = `https://www.${platform}.com/${username}`
---

<a href={href}>{platform}</a>

<style>
  a {
    padding: 0.5rem 1rem;
    color: white;
    background-color: #4c1d95;
    text-decoration: none;
    border-radius: 5px;
  }
</style>
